# Build output
/bin/
/dist/

# Runtime state: the database, the generated secret key, uploads.
/data/

# Frontend & root JS dependencies
node_modules/
.vite/
web/node_modules/
web/.vite/

# Documentation
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# The compiled SPA is embedded by //go:embed, but it is a build artifact.
# The marker is committed so `go build` works on a fresh clone.
/internal/web/dist/*
!/internal/web/dist/.gitkeep

.DS_Store
Thumbs.db
*.log
.claude/settings.local.json

